---
import { Picture } from 'astro:assets';
import type { FileObject } from '../api/schema';
import { imageSource } from '../lib/images';

export type Props = { file: FileObject };

const { file } = Astro.props;
---

{
  file.publicUrl && (
    <figure>
      {file.mimeType?.startsWith('image/') ? (
        <Picture src={imageSource(file.publicUrl)} formats={['avif', 'webp']} widths={[480, 768, 1024, 1536]} sizes="(max-width: 48rem) 100vw, 48rem" alt={file.metadata?.alternative ?? ''} loading="lazy" />
      ) : (
        <a href={file.publicUrl}>{file.name}</a>
      )}
      {file.metadata?.description && <figcaption>{file.metadata.description}</figcaption>}
    </figure>
  )
}
