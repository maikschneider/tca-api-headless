---
import type { HeadlessNavigationRead } from '../api/schema';
import { demoHref } from '../lib/api';

export type Props = { entries: HeadlessNavigationRead[]; current: string; flat?: boolean };

const { entries, current, flat = false } = Astro.props;
---

{
  entries.length > 0 && (
    <ul>
      {entries.map((entry) => {
        const href = new URL(demoHref(entry.url), 'https://static.example').pathname;
        return (
          <li>
            <a href={href} aria-current={href === current ? 'page' : undefined} class:list={[{ ancestor: href !== current && current.startsWith(href) }]}>
              {entry.nav_title || entry.title}
            </a>
            {!flat && <Astro.self entries={entry.children} current={current} />}
          </li>
        );
      })}
    </ul>
  )
}
