---
import { Code } from 'astro:components';
import type { Reveal } from '../lib/content';
import type { Language } from '../lib/config';
import { pointerLabel } from '../lib/excerpt';
import { t } from '../lib/i18n';
import { proofThemes } from '../lib/shiki';
import Mark from './Mark.astro';

export type Props = { recording: Reveal; language: Language; label?: string; class?: string };

// The proof of one rendered element: request, recorded JSON and generated type.
// A native disclosure, so it opens without JavaScript. The summary names what
// differs between proofs of one page: the element's place in the response.
const { recording, language, label, class: className } = Astro.props;
const s = t(language);
---

<details class:list={['proof', className]}>
  <summary>
    <Mark />
    <span class="proof-label">{label ?? s.proof}</span>
    <code class="proof-request">{recording.pointer ? pointerLabel(recording.pointer) : recording.request}</code>
  </summary>
  <div class="galley">
    <p class="proof-line"><span class="pane-label">{s.request}</span> <code>{recording.request}</code>{recording.pointer && <> <code class="proof-pointer">#{recording.pointer}</code></>} <span class="proof-status">{s.status} <code>{recording.status}</code></span></p>
    <p class="proof-note">{s.recorded}</p>
    <div class="panes">
      <div class="pane" data-pane="json">
        <p class="pane-label">{s.json}</p>
        <Code code={recording.json} lang={recording.lang} themes={proofThemes} defaultColor={false} wrap />
      </div>
      {recording.type && (
        <div class="pane" data-pane="type">
          <p class="pane-label">{s.type}</p>
          <Code code={recording.type} lang="typescript" themes={proofThemes} defaultColor={false} wrap />
        </div>
      )}
    </div>
  </div>
</details>
