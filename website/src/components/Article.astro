---
import type { Entry } from '../lib/content';
import Element from './Element.astro';
import SpecimenNote from './SpecimenNote.astro';

export type Props = { entry: Entry };

// Every other layout: the title, then the regions in the order the API sends
// them. An aside region sits beside the main one. A first element that repeats
// the page title doesn't print it twice.
const { entry } = Astro.props;
const { language, page } = entry;
const hasAside = entry.blocks.some((block) => block.region === 'aside');
const first = entry.blocks[0]?.items[0]?.content;
const shown = (content: Entry['blocks'][number]['items'][number]['content']) => content === first && content.header === page.title ? { ...content, header: '' } : content;
---

<article class:list={['article', { 'has-aside': hasAside }]}>
  <header class="article-head">
    <h1>{page.title}</h1>
    {entry.site === 'kettenblatt' && <SpecimenNote language={language} />}
  </header>
  {entry.blocks.map(({ region, items }) => (
    <div class:list={['region', `region-${region}`]}>
      {items.map((item) => <Element {...item} content={shown(item.content)} language={language} region={region} />)}
    </div>
  ))}
</article>
