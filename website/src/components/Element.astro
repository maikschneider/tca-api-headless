---
import { blocks, type Content } from './blocks';
import type { Reveal } from '../lib/content';
import type { Language } from '../lib/config';
import type { Ink } from '../lib/inks';
import Proof from './Proof.astro';

export type Props = { content: Content; reveal: Reveal; language: Language; region: string; class?: string; proof?: boolean; ink?: Ink };

// One content element and the proof it was rendered from.
const { content, reveal, language, region, class: className, proof = true, ink } = Astro.props;
const Block = blocks[content.CType] as (props: { content: Content; language: Language; region: string }) => unknown;
---

<div class:list={['element', `element-${content.CType}`, className]} data-ink={ink}>
  <slot />
  <Block content={content} language={language} region={region} />
  {proof && <Proof recording={reveal} language={language} />}
</div>
