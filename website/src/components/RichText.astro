---
import { PortableText } from 'astro-portabletext';
import type { HeadlessContentTextRead } from '../api/schema';
import PortableTextBlock from './PortableTextBlock.astro';
import PortableTextLink from './PortableTextLink.astro';

export type Props = { value: HeadlessContentTextRead['bodytext']; class?: string };

const { value, class: className } = Astro.props;
---

<div class:list={['prose', className]}>
  <PortableText value={value ?? []} components={{ block: { normal: PortableTextBlock }, mark: { link: PortableTextLink } }} />
</div>
