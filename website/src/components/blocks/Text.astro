---
import type { HeadlessContentTextmediaRead, HeadlessContentTextRead } from '../../api/schema';
import type { Language } from '../../lib/config';
import Heading from '../Heading.astro';
import RichText from '../RichText.astro';
import Figure from '../Figure.astro';

export type Props = { content: HeadlessContentTextRead | HeadlessContentTextmediaRead; language: Language; region: string };

const { content, language } = Astro.props;
const assets = content.CType === 'textmedia' ? (content.assets ?? []) : [];
---

<section class="block block-text">
  <Heading header={content.header} link={content.header_link} language={language} />
  <RichText value={content.bodytext} />
  {assets.map((file) => <Figure file={file} />)}
</section>
