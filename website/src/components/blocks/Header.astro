---
import type { HeadlessContentHeaderRead } from '../../api/schema';
import type { Language } from '../../lib/config';
import Heading from '../Heading.astro';

export type Props = { content: HeadlessContentHeaderRead; language: Language; region: string };

const { content, language } = Astro.props;
---

<section class="block block-header">
  <Heading header={content.header} link={content.header_link} language={language} />
</section>
