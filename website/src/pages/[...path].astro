---
import Article from '../components/Article.astro';
import Product from '../components/Product.astro';
import Layout from '../layouts/Layout.astro';
import { loadBuild, type Entry } from '../lib/content';
import { prefix } from '../lib/config';

export async function getStaticPaths() {
  const { entries } = await loadBuild();
  return entries.map((entry) => ({ params: { path: entry.output.slice(prefix.length).replace(/^\/|\/$/g, '') || undefined }, props: { entry } }));
}
export type Props = { entry: Entry };
const { entry } = Astro.props;
// The product layout is recognised by its hero region, not by the page.
const product = entry.blocks.some((block) => block.region === 'hero');
---

<Layout entry={entry}>
  {product ? <Product entry={entry} /> : <Article entry={entry} />}
</Layout>
