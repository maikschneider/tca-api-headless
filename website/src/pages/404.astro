---
import { loadBuild } from '../lib/content';
import Proof from '../components/Proof.astro';
import Head from '../layouts/Head.astro';
import { output } from '../lib/config';
const { missing } = await loadBuild();
---

<!doctype html>
<html lang="en">
  <head>
    <Head title="Page not found" language="en" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main id="main" class="not-found">
      <article class="article">
        <header class="article-head">
          <h1>Page not found</h1>
        </header>
        <div class="prose">
          <p>The path lookup returned no page, so the build emitted none. <a href={output('')}>Back to the home page</a>.</p>
        </div>
        <Proof recording={missing} language="en" />
      </article>
    </main>
  </body>
</html>
