---
import type { HeadlessContentTableRead } from '../../api/schema';
import Heading from '../Heading.astro';

export type Props = { content: HeadlessContentTableRead };

const { content } = Astro.props;
const table = content.bodytext ?? { head: [], body: [], foot: [] };
---

<section class="block">
  <Heading header={content.header} link={content.header_link} />
  <table>
    {content.table_caption && <caption>{content.table_caption}</caption>}
    {table.head.length > 0 && <thead><tr>{table.head.map((cell) => <th>{cell}</th>)}</tr></thead>}
    <tbody>{table.body.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
    {table.foot.length > 0 && <tfoot><tr>{table.foot.map((cell) => <td>{cell}</td>)}</tr></tfoot>}
  </table>
</section>
