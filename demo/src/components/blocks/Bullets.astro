---
import type { HeadlessContentBulletsRead } from '../../api/schema';

export type Props = { content: HeadlessContentBulletsRead };
type Term = { term: string; definition: string };

const { content } = Astro.props;
const items: (string | Term)[] = content.bodytext ?? [];
const terms = items.filter((item): item is Term => typeof item !== 'string');
---

<section class="block">
  {content.header && <h2>{content.header}</h2>}
  {
    terms.length > 0 ? (
      <dl>{terms.map((item) => [<dt>{item.term}</dt>, <dd>{item.definition}</dd>])}</dl>
    ) : (
      <ul>{items.map((item) => <li>{item}</li>)}</ul>
    )
  }
</section>
