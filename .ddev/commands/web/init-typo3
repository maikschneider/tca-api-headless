#!/usr/bin/env bash
# shellcheck disable=SC2086
set -e

## Description: Initialize TYPO3 installation
## Usage: init-typo3
## Example: ddev init-typo3

readonly dbHost="db"
readonly dbUser="db"
readonly dbPassword="db"
readonly dbName="db"
readonly dbCredentials="-h${dbHost} -u${dbUser} -p${dbPassword}"
readonly projectPath="/var/www/html"
readonly fixturePath="${projectPath}/Tests/Functional/Fixtures"
readonly typo3Binary="${projectPath}/vendor/bin/typo3"

function _progress() {
    printf "%s... " "$1"
}

function _done() {
    printf "\e[32mDone\e[39m\n"
}

_progress "Creating empty database"
mysql -Nse "SHOW TABLES" $dbCredentials "$dbName" | while read -r table; do
    mysql -e "DROP TABLE ${table}" $dbCredentials "$dbName"
done
_done

export TYPO3_DB_DRIVER=mysqli
export TYPO3_DB_USERNAME="$dbUser"
export TYPO3_DB_PASSWORD="$dbPassword"
export TYPO3_DB_PORT=3306
export TYPO3_DB_HOST="$dbHost"
export TYPO3_DB_DBNAME="$dbName"
export TYPO3_SERVER_TYPE=other
export TYPO3_PROJECT_NAME="EXT:tca_api_headless"
export TYPO3_SETUP_ADMIN_USERNAME=admin
export TYPO3_SETUP_ADMIN_PASSWORD='Passw0rd!'
export TYPO3_SETUP_ADMIN_EMAIL=admin@example.com

_progress "Setting up TYPO3 installation"
    "$typo3Binary" setup --no-interaction --force --quiet
_done

_progress "Updating database schema"
    "$typo3Binary" extension:setup
_done

# The page tree of the functional tests, served by two sites: "main" with the
# add-on's site set, "other" with TCA API only.
for file in "$fixturePath"/*.csv; do
    _progress "Importing $(basename "$file")"
    python3 - "$file" <<'PYEOF' | mysql $dbCredentials "$dbName"
import csv, sys

with open(sys.argv[1], newline='') as f:
    rows = list(csv.reader(f))

table   = rows[0][0].strip('"')
columns = rows[1][1:]
for row in rows[2:]:
    values = row[1:]
    if not any(v.strip() for v in values):
        continue
    print('INSERT INTO `{}` ({}) VALUES ({});'.format(
        table,
        ', '.join('`{}`'.format(c) for c in columns),
        ', '.join("'{}'".format(v.replace("'", "''")) for v in values),
    ))
PYEOF
    _done
done

_progress "Creating sites"
for site in main other second; do
    mkdir -p "${projectPath}/config/sites/${site}"
    sed "s#http://${site}.localhost/#${DDEV_PRIMARY_URL}/${site}/#; s#http://localhost/#${DDEV_PRIMARY_URL}/#" \
        "${fixturePath}/Sites/${site}/config.yaml" > "${projectPath}/config/sites/${site}/config.yaml"
    if [ -f "${fixturePath}/Sites/${site}/settings.yaml" ]; then
        cp "${fixturePath}/Sites/${site}/settings.yaml" "${projectPath}/config/sites/${site}/settings.yaml"
    fi
done
"$typo3Binary" cache:flush
_done
